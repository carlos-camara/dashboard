@gui @dashboard @smoke
Feature: Dashboard View Validation # features/dashboard/gui/gui_dashboard.feature:2

  Background:   # features/dashboard/gui/gui_dashboard.feature:4

  Scenario: Verify Header and Status Ticker                                                                                    # features/dashboard/gui/gui_dashboard.feature:8
    Given I navigate to the dashboard at "http://localhost:3000/dashboard/"                                                    # .venv/src/qa-automation-framework/qa_framework/steps/gui_steps.py:172
    And the "dashboard" page is displayed                                                                                      # .venv/src/qa-automation-framework/qa_framework/steps/gui_steps.py:249
    Then the page title should be "[LANG:common.page_title]"                                                                   # .venv/src/qa-automation-framework/qa_framework/steps/gui_steps.py:37
    Then the following elements should contain these texts                                                                     # .venv/src/qa-automation-framework/qa_framework/steps/gui_steps.py:330
      | element         | value                            |
      | header_subtitle | [LANG:dashboard.header.subtitle] |
    And the system status should be valid                                                                                      # features/steps/step_gui_interactions.py:85
    Then the "header and status" page should visually match the baseline image "dashboard_header_status" with a 3.0% tolerance # None

  Scenario: Verify Statistics Cards                                                                                     # features/dashboard/gui/gui_dashboard.feature:16
    Given I navigate to the dashboard at "http://localhost:3000/dashboard/"                                             # .venv/src/qa-automation-framework/qa_framework/steps/gui_steps.py:172
    And the "dashboard" page is displayed                                                                               # .venv/src/qa-automation-framework/qa_framework/steps/gui_steps.py:249
    Then the following elements should contain these texts                                                              # .venv/src/qa-automation-framework/qa_framework/steps/gui_steps.py:330
      | element            | value                                   |
      | stats_passed_card  | [LANG:dashboard.stats.system_health]    |
      | stats_total_runs   | [LANG:dashboard.stats.total_executions] |
      | stats_pass_rate    | [LANG:dashboard.stats.pass_rate]        |
      | stats_avg_duration | [LANG:dashboard.stats.avg_latency]      |
    Then the "stats grid" element should visually match the baseline image "dashboard_stats_grid" with a 5.0% tolerance # None

  Scenario: Verify Timeline Controls                                                                                          # features/dashboard/gui/gui_dashboard.feature:25
    Given I navigate to the dashboard at "http://localhost:3000/dashboard/"                                                   # .venv/src/qa-automation-framework/qa_framework/steps/gui_steps.py:172
    And the "dashboard" page is displayed                                                                                     # .venv/src/qa-automation-framework/qa_framework/steps/gui_steps.py:249
    Then the following elements should contain these texts                                                                    # .venv/src/qa-automation-framework/qa_framework/steps/gui_steps.py:330
      | element          | value                             |
      | timeline_heading | [LANG:dashboard.timeline.heading] |
    And I should see at least 1 elements with selector "timeline_chart"                                                       # .venv/src/qa-automation-framework/qa_framework/steps/gui_steps.py:357
    When I switch the chart view to "[LANG:dashboard.timeline.volume]"                                                        # features/steps/step_gui_interactions.py:57
    And I wait for 1 seconds                                                                                                  # .venv/src/qa-automation-framework/qa_framework/steps/common_steps.py:4
    Then the "volume chart" element should visually match the baseline image "dashboard_chart_volume" with a 5.0% tolerance   # None
    When I switch the chart view to "[LANG:dashboard.timeline.success]"                                                       # None
    And I wait for 1 seconds                                                                                                  # None
    Then the "success chart" element should visually match the baseline image "dashboard_chart_success" with a 5.0% tolerance # None

  Scenario: Verify Incident and Sector Lists                                                                               # features/dashboard/gui/gui_dashboard.feature:37
    Given I navigate to the dashboard at "http://localhost:3000/dashboard/"                                                # .venv/src/qa-automation-framework/qa_framework/steps/gui_steps.py:172
    And the "dashboard" page is displayed                                                                                  # .venv/src/qa-automation-framework/qa_framework/steps/gui_steps.py:249
    Then the following elements should contain these texts                                                                 # .venv/src/qa-automation-framework/qa_framework/steps/gui_steps.py:330
      | element             | value                                |
      | recent_runs_heading | [LANG:dashboard.recent_runs.heading] |
      | incidents_heading   | [LANG:dashboard.incidents.heading]   |
    Then the "lists panel" element should visually match the baseline image "dashboard_lists_panels" with a 5.0% tolerance # None

  Scenario: Verify Endpoints Catalog and Scroll                                                                                # features/dashboard/gui/gui_dashboard.feature:44
    Given I navigate to the dashboard at "http://localhost:3000/dashboard/"                                                    # .venv/src/qa-automation-framework/qa_framework/steps/gui_steps.py:172
    And the "dashboard" page is displayed                                                                                      # .venv/src/qa-automation-framework/qa_framework/steps/gui_steps.py:249
